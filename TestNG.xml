<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Suite">

    <listeners>
        <listener class-name="com.opencart.Listeners.TestListener"/>
    </listeners>

    <test name="Automation Tests">

        <classes>

            <class name="com.opencart.tests.LoginTest"/>
            <class name="com.opencart.tests.SearchTest"/>
            <class name="com.opencart.tests.RegistrationTest"/>
            <class name="com.opencart.tests.ProductDetailsTest"/>
            <class name="com.opencart.tests.ShoppingCartTest"/>
        </classes>

    </test>

</suite>